{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outlook for Linux",
  "version": "0.1.0",
  "identifier": "com.nikolainyegaard.outlookforlinux",
  "build": {
    "frontendDist": "https://outlook.office.com/mail/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Outlook",
        "url": "https://outlook.office.com/mail/",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
