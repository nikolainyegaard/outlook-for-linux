{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outlook for Linux",
  "version": "0.3.0",
  "identifier": "com.nikolainyegaard.outlookforlinux",
  "build": {
    "frontendDist": "https://outlook.office.com/mail/"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mailto"]
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "desktopTemplate": "./main.desktop"
      },
      "rpm": {
        "desktopTemplate": "./main.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
